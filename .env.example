# URL base del backend Laravel.
# En desarrollo con nginx/Docker no hace falta cambiar esto:
# el navegador llama a /api/v1/... en el mismo dominio y nginx lo enruta.
VITE_API_BASE_URL=/api/v1

# Dominio del Cloudflare Tunnel (sin https://).
# Solo necesario si querés Hot Module Replacement (actualización en vivo)
# a través del tunnel. Si no lo ponés, el HMR no funciona remotamente
# pero la app sigue funcionando correctamente.
# Ejemplo: VITE_HMR_HOST=mi-proyecto.example.com
VITE_HMR_HOST=
